{
    "name": "fwhy/blast",
    "description": "Static site generator made in PHP",
    "version": "0.0.7",
    "keywords": [
        "ssg",
        "static site generator"
    ],
    "license": [
        "MIT"
    ],
    "autoload": {
        "psr-4": {
            "Fwhy\\Blast\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fwhy\\Blast\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "fwhy",
            "email": "prog@fullwidth-hyphen.tech"
        }
    ],
    "require": {
        "php": ">=8.5",
        "eftec/bladeone": "^5",
        "symfony/yaml": "^8",
        "league/commonmark": "^2.10"
    },
    "bin": [
        "bin/blast"
    ],
    "scripts": {
        "build": "bin/blast build",
        "dev": "bin/blast dev -p 3000",
        "test": "vendor/bin/pest",
        "phpstan": "vendor/bin/phpstan analyse",
        "check": [
            "@phpstan",
            "@test"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "phpstan/phpstan": "^2.3",
        "pestphp/pest": "^5.3"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
